{
  "name": "nudo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API y servidor web para NUDO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test ../tests/*.test.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:lab:generate": "prisma generate --schema prisma-lab/schema.prisma",
    "prisma:lab:validate": "prisma validate --schema prisma-lab/schema.prisma"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "express": "^5.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
